{% function block.generate_tag(t, f, tc) %}
{% local tc = tc or vars.count_tag(t, f) %}
{% if tc == 0 or tc == nil then %}
<a class="{% if t == tag then %}current {% end %} empty" href="{%& vars.siteurl %}/filters/{%& f %}/tags/{%& t %}">{%& t %}</a>
{% else %}
<a class="{% if t == tag then %}current{% end %}" href="{%& vars.siteurl %}/filters/{%& f %}/tags/{%& t %}">{%& t %}({%& tc %})</a>
{% end %}
{% end %}

{% function block.header() %}
<div class="cluster"><fieldset id="page-meta">
<legend><h2>Tag : <a href="{%& url %}">{%& tag %}({%& total_pages %})</a></h2></legend>
{% render('partial/group', {tag = tag, filter=filter}) %}
{% if other_filters ~= nil then %}
<fieldset>
<legend>{%& tag %} is found in filters</legend>
<ul>
{% for k, v in pairs(other_filters) do %}
<li>
{% if v > 0 then %}
<a class="{% if k == filter then %}current{% end %}" href="{%& vars.siteurl %}/filters/{%& k %}/tags/{%& tag %}">{%& k %}({%& v %})</a>
{% else %}
<a class="empty {% if k == filter then %}current{% end %}" href="{%& vars.siteurl %}/filters/{%& k %}/tags/{%& tag %}">{%& k %}</a>
{% end %}
</li>
{% end %}
</ul>
</fieldset>
{% end %}

{% if #aka > 0 then %}
<fieldset>
<legend>{%& tag %} is also known as</legend>
<ul>
{% for i, t in ipairs(aka) do %}
  <li>{% block.generate_tag(t, filter) %}</li>
{% end %}
</ul>
</fieldset>
{% end %}

{% if #related > 0 then %}
<fieldset>
<legend>{%& tag %} is related to</legend>
<ul>
{% for i, t in ipairs(related) do %}
  <li>{% block.generate_tag(t, filter) %}</li>
{% end %}
</ul>
</fieldset>
{% end %}
</fieldset></div>

{% end %}

{% function block.content() %}
{% if #pages > 0 then %}
{% render('pages', {url = url, tag = tag, pages = pages, filter = filter, 
                    offset = offset, total_pages = total_pages, limit = limit}) %}
{% else %}
No pages found associated with '{%& tag %}' in {%& filter %}.
{% end %}
{% end %}

{% render('layouts/base', {current_page="tags"}) %}
